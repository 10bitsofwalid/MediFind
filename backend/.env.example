# ==============================================================================
# MediFind Backend Environment Configuration (Safe Template)
# Never place real passwords, JWT secrets, database credentials, or API keys here.
# Copy this file to .env and configure for your local or staging environment.
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production' | 'test')
NODE_ENV=development

# HTTP Service Port
PORT=5000

# MongoDB Connection String (MongoDB 6+ with 2dsphere index support)
# Local:   mongodb://localhost:27017/medifind
# Staging: mongodb+srv://<staging_user>:<staging_password>@<staging_cluster>.mongodb.net/medifind_staging?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medifind

# JSON Web Token Secret Key
# Required in staging and production (minimum 32 characters random secret).
# For local development only, falls back to internal safe default if unset.
JWT_SECRET=replace_with_secure_random_jwt_secret_in_staging

# Stock Quality & Freshness Thresholds (Developer 3 Coordination Agreement)
# Stale threshold in hours before stock status displays a 'stale' freshness warning (default 24)
STALE_THRESHOLD_HOURS=24

# Discrepancy report count threshold before stock is flagged 'unverified' (default 3)
UNVERIFIED_REPORT_THRESHOLD=3

# Allowed CORS Origins (comma-separated list for Vite dev server / staging frontend)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:3000
